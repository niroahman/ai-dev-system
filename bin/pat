#!/bin/bash
# Usage:
#   pat fix/login-bug          # new worktree, editor, Claude
#   pat -c                      # continue in previous worktree
#   pat -c -w /path/to/wt       # continue in specific worktree
#   mat fix/login-bug           # gemini variant
#   mat -c                      # continue, gemini
set -e
source "$HOME/dev-system/bin/_lib.sh"

cont=0
wt_path=""
skip_watson=0

while [[ $# -gt 0 ]]; do
  case "$1" in
    -c) cont=1; shift ;;
    -w) wt_path="$2"; shift 2 ;;
    --no-watson) skip_watson=1; shift ;;
    *) break ;;
  esac
done

branch="${1:-}"

case "$(basename "$0")" in
  mat) agent="gemini" ;;
  *)   agent="claude" ;;
esac

resolve_role "$agent"
repo_root=$(git worktree list --porcelain | awk 'NR==1{print $2}')
repo_name=$(basename "$repo_root")

# --- Determine worktree ---
if [ "$cont" = "1" ]; then
  if [ -n "$wt_path" ]; then
    dir="$wt_path"
  else
    dir=$(find_continue_wt)
    if [ -z "$dir" ]; then
      echo "❌ No previous worktree found. Run watson or nikke first, or use -w <path>."
      exit 1
    fi
  fi

  if [ ! -d "$dir" ]; then
    echo "❌ Worktree gone: $dir"
    exit 1
  fi

  window_name="${ROLE_NAME}-$(basename "$dir")"
  printf "♻️  Reusing worktree: %s\n" "$(basename "$dir")"
else
  # New worktree
  if [ -z "$branch" ]; then
    echo "Usage: $(basename "$0") <branch>       new worktree"
    echo "       $(basename "$0") -c             continue previous"
    echo "       $(basename "$0") -c -w <path>   continue specific"
    exit 1
  fi

  # Hard cap: max 3 active worktrees
  active=$(git worktree list | wc -l)
  if [ "$((active - 1))" -ge 3 ]; then
    echo "You have $((active - 1)) active worktrees. Finish one first:"
    git worktree list
    exit 1
  fi

  dir="$repo_root/../wt-${repo_name}-${branch//\//-}"
  window_name="${ROLE_NAME}-${branch//\//-}"

  git worktree add "$dir" -b "$branch"

  build-context "$dir/.agent-context.md"
  setup_worktree "$dir" "$repo_root"
fi

# --- Watson maps the codebase first ---
[ "$skip_watson" = "0" ] && run_watson_inline "$dir"

# --- Write task spec ---
# Using printf to avoid heredoc quoting issues with variables
{
  printf '%s\n\n' "$ROLE_PORTRAIT_MD"
  cat <<'TASKBODY'
# Context

Read in this order before starting:
1. .ai-team/context/TICKET.md — the ticket
2. .ai-team/context/*.png, *.jpg — screenshots
3. .ai-team/context/*.md — architecture docs
4. .ai-team/WATSON_MAP.md — Watson's codebase map (relevant files, code paths)
5. .ai-team/INVESTIGATION.md — Nikke's root cause analysis and recommended fix
6. AGENTS.md — repo conventions (follow these strictly)
7. .agent-context.md — personal skills

# Task

Implement the fix described in the ticket and investigation.

Rules:
- Follow AGENTS.md conventions for code style, testing, and patterns.
- Prefer MCP tools over raw Bash: use `mcp__safe-tools__run_tests` to run tests, `mcp__safe-tools__run_install` to install deps, `mcp__safe-tools__run_linter` for linting. Fall back to Bash only if the MCP tool is unavailable.
- **Stay inside the worktree.** All file operations limited to current directory and repo root. No recursive searches outside the project (no `find ~` or `/Users/...`). Use `pip show`, `python3 -c "import..."`, or `git grep` instead.
- Stay in scope — only change what is needed for the fix.
- Use the files Watson identified in WATSON_MAP.md as your starting point.
- Try to run tests after making changes. If tests fail to execute (environment issue, missing deps, PYTHONPATH problems), log the command in BLOCKED.md and move on — do not spend more than one attempt on test environment setup.
- Do not leave debug code, TODOs, or commented-out blocks.

# Failure handling

If any command fails (tests, linter, installs, pip):
- Try once with an obvious fix. If it fails again, stop retrying that command.
- Do NOT use AskUserQuestion. Do NOT wait for input.
- Record the failed command and error in .ai-team/BLOCKED.md and continue with the rest of the work.
- If the failure blocks the core task, write what you could not complete to BLOCKED.md and proceed to the review cycle and FIX-SUMMARY.md anyway.

BLOCKED.md format:
```
## Blocked commands
- `<command>` — <exact error message>
```

Stay inside the worktree — all file operations limited to this directory
and the repo root. No recursive searches outside the project (no `find ~`,
`/Users/`, `/usr/local/lib`, etc.). To find installed package paths use:
`python3 -c "import MODULE; print(MODULE.__file__)"` instead of find.

# Review cycle

`poirot` is a shell command that runs a separate Claude instance as a code reviewer. It reads your git diff, the task, and AGENTS.md, then writes a review to `.ai-team/REVIEW.md`. It runs in the foreground and may take 20–60 seconds. It exits on its own — do not interrupt it.

When you have finished the fix:
1. Run `poirot` from the shell with a 5-minute timeout (300000 ms) — it spawns a separate Claude process and takes 1–5 minutes. Wait for it to exit fully. Then read .ai-team/REVIEW.md.
2. Address every issue Poirot raised. Fix the code.
3. Run `poirot` once more — max 2 runs total. If issues persist, add them to BLOCKED.md and continue to FIX-SUMMARY.md.
4. Write .ai-team/FIX-SUMMARY.md with:

## What changed
Every file modified and what was done.

## Why
Reasoning behind each decision. Flag anything uncertain.

## Anything skipped or deferred
Things you noticed but did not change.

## Commands that could not run
List any commands from BLOCKED.md here. Empty section if none.

TASKBODY
  printf 'Once FIX-SUMMARY.md is written, your job is done.\n'
  printf 'The worktree stays open for the human to review.\nDo not commit, do not push, do not clean up. Exit cleanly.\n'
} > "$dir/.agent-task.md"

# --- Housekeeping ---
mkdir -p "$dir/.ai-team"
cp "$HOME/dev-system/portraits/$(echo "$ROLE_NAME" | tr '[:upper:]' '[:lower:]').png" "$dir/.ai-team/" 2>/dev/null || true
rm -f "$dir/.investigate-prompt.md"
write_claude_settings "$dir"
track_worktree "$(basename "$0")" "$dir"

# --- Launch ---
printf "\n🔨 \033[1;32m%s\033[0m is taking on \033[1;36m%s\033[0m\n\n" "$ROLE_NAME" "$(basename "$dir")"

if [ "$agent" = "gemini" ]; then
  agent_cmd="${MODEL_MAT:-gemini --model flash}"
else
  _pat_model="${MODEL_PAT:-claude}"
  [ "$_pat_model" = "claude" ] && agent_cmd="claude" || agent_cmd="claude --model \"$_pat_model\""
fi

launch_tmux "$dir" "$window_name" "$agent_cmd \"Read .agent-task.md and start the task.\""
